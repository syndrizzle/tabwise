---
import ThemeScript from "@/components/theme/ThemeScript.astro"
import Analytics from "@/components/Analytics.astro"
import { siteGraph } from "@/lib/schema"
import bodyFont from "@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url"
import headingFont from "@fontsource-variable/roboto-slab/files/roboto-slab-latin-wght-normal.woff2?url"
import "@/styles/global.css"

interface Props {
  title: string
  description: string
  noindex?: boolean
  schema?: Record<string, unknown>[]
}

const { title, description, noindex = false, schema = [] } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const image = new URL("/og-image.png?v=2", Astro.site)
const imageAlt =
  "Tabwise. Find a tablet for the way you study. Notes, PDFs and diagrams. Find your tablet."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="robots"
      content={noindex ? "noindex" : "index, follow, max-image-preview:large"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tabwise" />
    <meta property="og:locale" content="en_IN" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={headingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <ThemeScript />
    {!noindex && <Analytics />}
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(siteGraph(Astro.site!, schema))}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
