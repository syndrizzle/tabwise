---
import Layout from "@/layouts/main.astro"
import Header from "@/components/Header.astro"
import { TextLink } from "@/components/TextLink"
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import { breadcrumbList, type Crumb } from "@/lib/schema"

interface Props {
  title: string
  description: string
  width: string
  crumbs: Crumb[]
  schema?: Record<string, unknown>[]
}

const { title, description, width, crumbs: pageCrumbs, schema = [] } = Astro.props
const crumbs = [{ name: "Tabwise", href: "/" }, ...pageCrumbs]
const links = [
  { href: "/", label: "Finder" },
  { href: "/tablets/", label: "Tablets" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "How we choose" },
]
const isCurrent = (href: string) =>
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href)
---

<Layout
  title={title}
  description={description}
  schema={[breadcrumbList(Astro.site!, crumbs), ...schema]}
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-background focus:p-4"
  >
    Skip to content
  </a>
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <Header />
    <nav
      aria-label="Main navigation"
      class="flex flex-wrap justify-center gap-x-1 text-sm text-muted-foreground sm:gap-x-6"
    >
      {links.map((link) => (
        <TextLink
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
          variant="ghost"
        >
          {link.label}
        </TextLink>
      ))}
    </nav>
    <main id="main" class:list={["mx-auto pt-14 pb-24 sm:pt-20", width]}>
      <Breadcrumbs crumbs={crumbs} />
      <slot />
    </main>
  </div>
</Layout>

<style is:global>
  .page-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .page-intro {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: var(--muted-foreground);
    line-height: 1.8;
  }

  .prose-section {
    margin-top: 3rem;
  }

  .prose-section h2 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .prose-section p,
  .prose-section li {
    color: var(--muted-foreground);
    line-height: 1.85;
  }

  .prose-section p + p {
    margin-top: 1rem;
  }

  .prose-section ol,
  .prose-section ul {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
  }

  .prose-section ol {
    list-style: decimal;
  }

  .prose-section ul {
    list-style: disc outside;
  }
</style>
