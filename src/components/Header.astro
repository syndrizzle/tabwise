---
import Logo from "@/components/Logo.astro"
import { ModeToggle } from "@/components/ModeToggle"
---

<header>
  <div class="grid grid-cols-[1fr_auto_1fr] items-center py-6">
    <a
      href="/"
      aria-label="Tabwise home"
      class="col-start-2 flex items-center gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
    >
      <Logo class="size-7" />
      <span class="text-base font-semibold tracking-tight">Tabwise</span>
    </a>
    <div class="col-start-3 justify-self-end">
      <ModeToggle client:load />
    </div>
  </div>
</header>
