---
import type { Tablet } from "@/catalog/catalog"
import { withOptimizedImages } from "@/catalog/images"
import { pageIds } from "@/finder/page"

interface Props {
  tablets: Tablet[]
}

const tablets = await withOptimizedImages(Astro.props.tablets)
---

<div id={pageIds.root} class="w-full"></div>
<script
  id={pageIds.catalog}
  type="application/json"
  is:inline
  set:html={JSON.stringify(tablets)}
></script>
