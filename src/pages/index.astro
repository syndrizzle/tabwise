---
import Layout from "@/layouts/main.astro"
import Header from "@/components/Header.astro"
import TabletHero from "@/components/TabletHero.astro"
import { FinderLauncher } from "@/finder/FinderLauncher"
import { TextLink } from "@/components/TextLink"
import FinderMount from "@/finder/FinderMount.astro"
import { priceDates, tablets } from "@/catalog/catalog"
import { postBySlug, postPath } from "@/blog/posts"
import { formatDateRange } from "@/lib/format"
import { pageIds } from "@/finder/page"

const title = "Student tablet finder in India, with or without a pen | Tabwise"
const description =
  "Find a student tablet for notes, PDFs, lectures and reading. Compare dated India prices, with a pen or without."
const dates = priceDates()
const priceRange = formatDateRange(dates[0], dates.at(-1)!)
const guide = postBySlug("tablet-for-handwritten-notes")
---

<Layout title={title} description={description}>
  <a
    href={`#${pageIds.main}`}
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:ring-2 focus:ring-ring"
  >
    Skip to content
  </a>
  <div class="mx-auto flex min-h-svh max-w-6xl flex-col px-6 sm:px-10">
    <Header />
    <main
      id={pageIds.main}
      data-view="home"
      class="flex flex-1 flex-col items-center justify-center pt-4 pb-10 text-center sm:pb-12"
    >
      <section id={pageIds.hero} class="flex flex-col items-center">
        <TabletHero />
        <h1 class="max-w-3xl font-heading text-[clamp(1.875rem,9.2vw,2.25rem)] leading-[1.15] tracking-tight sm:text-[3.5rem]">
          Find a tablet for
          <br class="hidden sm:block" /> the way you study.
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
          Notes, PDFs, lectures and everyday study, with a pen or without.
        </p>
        <FinderLauncher client:idle />
        <nav
          aria-label="Explore Tabwise"
          class="mt-3 flex gap-5 text-xs text-muted-foreground"
        >
          <TextLink href="/tablets/" variant="ghost" size="xs">
            Browse tablets
          </TextLink>
          <TextLink href="/about/" variant="ghost" size="xs">
            How we choose
          </TextLink>
        </nav>
        <noscript>
          <p class="mt-4 text-sm text-muted-foreground">
            Enable JavaScript to answer the guided questions and find a tablet.
          </p>
        </noscript>
        <section
          aria-labelledby="how-it-works"
          class="mt-20 grid max-w-4xl gap-10 text-left sm:grid-cols-3"
        >
          <h2 id="how-it-works" class="sr-only">How Tabwise works</h2>
          <div>
            <h3 class="font-medium">The whole setup is counted</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              When you want a pen, your budget covers the tablet and its
              compatible active pen together, so a cheap tablet with an
              expensive pen never looks cheaper than it is.
            </p>
          </div>
          <div>
            <h3 class="font-medium">Only verified pens</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              A tablet qualifies for handwritten notes only when a named active
              pen is listed as compatible and palm rejection is documented.
            </p>
          </div>
          <div>
            <h3 class="font-medium">Dated, sourced prices</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {tablets.length} student tablets with India prices checked on
              {" "}{priceRange}. Each one links to the manufacturer and seller.
            </p>
          </div>
          <p class="text-sm sm:col-span-3">
            New to note-taking tablets? Read{" "}
            <a
              href={postPath(guide)}
              class="text-primary underline-offset-4 hover:underline"
              >{guide.title.toLowerCase()}</a
            >.
          </p>
        </section>
      </section>
      <FinderMount tablets={tablets} />
    </main>
  </div>
</Layout>

<style>
  [hidden] {
    display: none !important;
  }

  main[data-view="questions"] {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  main[data-view="results"] {
    justify-content: flex-start;
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  @media (max-width: 767px) {
    main[data-view="questions"],
    main[data-view="results"] {
      justify-content: flex-start;
      padding-top: 0.75rem;
    }
  }
</style>
