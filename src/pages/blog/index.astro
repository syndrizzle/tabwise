---
import PageLayout from "@/layouts/PageLayout.astro"
import { postPath, posts } from "@/blog/posts"
import { formatDate } from "@/lib/format"
---

<PageLayout
  title="Student tablet guides for notes and PDFs | Tabwise"
  description="Guides for choosing a student tablet in India: handwritten notes, active pens, palm rejection and complete setup costs, based on sourced evidence."
  crumbs={[{ name: "Blog", href: "/blog/" }]}
  width="max-w-2xl"
>
  <h1 class="page-heading">Guides</h1>
  <p class="page-intro">
    Longer answers to the questions the finder asks, written from the same
    sourced catalog.
  </p>
  <ul class="mt-12 grid gap-10">
    {
      posts.map((post) => (
        <li>
          <h2 class="text-xl font-semibold tracking-tight">
            <a href={postPath(post)} class="hover:underline">
              {post.title}
            </a>
          </h2>
          <p class="mt-2 text-muted-foreground">{post.description}</p>
          <p class="mt-2 text-xs text-muted-foreground">
            <time datetime={post.updated}>{formatDate(post.updated)}</time>
          </p>
        </li>
      ))
    }
  </ul>
</PageLayout>
